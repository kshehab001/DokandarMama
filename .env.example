# ---------------------------------------------------------------------------
# Dokandar Mama — environment variables
#
# Copy this file to .env for local development (`cp .env.example .env`).
# For Render, these map to the "envVars" in render.yaml — Render will
# prompt you for the ones marked (secret) when you deploy the Blueprint.
# ---------------------------------------------------------------------------

# --- Database ---
# Local dev: point at a local Postgres, e.g. postgres://postgres:postgres@localhost:5432/dokandar_mama
# Render: filled in automatically from the managed database — you don't set this yourself.
DATABASE_URL=

# --- Clerk authentication (secret) ---
# Create a free Clerk application at https://dashboard.clerk.com, then copy
# these two keys from Configure > API Keys.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Same value as CLERK_PUBLISHABLE_KEY, but exposed to the frontend build
# (Vite only exposes env vars prefixed with VITE_ to client code).
VITE_CLERK_PUBLISHABLE_KEY=

# --- Server ---
NODE_ENV=development
PORT=5000

# Only needed if you deploy the frontend and API as two SEPARATE services
# (rather than the combined single-service setup render.yaml uses by
# default). Comma-separated list of origins allowed to call the API, e.g.
# https://dokandar-mama.example.com
CORS_ALLOWED_ORIGINS=

# --- Platform administration (server-only) ---
# Comma-separated immutable Clerk user IDs allowed to use /admin. Do not use
# email addresses: the API deliberately ignores client-sent email headers for
# authorization. Leave blank if the deployment has no platform administrator.
SUPER_ADMIN_USER_IDS=

# Path to the frontend's built static files (artifacts/dokandar-mama/dist/public).
# Set this to have the API server also serve the frontend from the same
# URL — this is what render.yaml does for the one-click combined deploy.
# Leave unset to run the API standalone.
SERVE_STATIC_DIR=

# --- Chotu AI (server-only; never put this in VITE_ variables) ---
# Create an OpenAI API key and add it to the API service's environment.
# OPENAI_MODEL can be changed to any Responses API model enabled for your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
